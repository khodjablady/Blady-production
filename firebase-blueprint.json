{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions in the MES ERP system",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "role": {
          "type": "string",
          "enum": ["operator", "supervisor", "admin", "quality", "maintenance"],
          "description": "System role for RBAC"
        },
        "jobTitle": {
          "type": "string",
          "description": "User position or responsibility in plant"
        },
        "modulePermissions": {
          "type": "object",
          "description": "Granular module permissions mapping"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "OrdreFabricationDoc": {
      "title": "OrdreFabricationDoc",
      "description": "Manufacturing production order in MES",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order unique identifier"
        },
        "articleCode": {
          "type": "string",
          "description": "Finished product code"
        },
        "quantiteDemandee": {
          "type": "number",
          "description": "Planned quantity"
        },
        "quantiteProduite": {
          "type": "number",
          "description": "Actual produced quantity"
        },
        "statut": {
          "type": "string",
          "enum": ["Planifie", "EnPreparation", "EnMelange", "EnConditionnement", "ControleQualite", "Termine", "Annule", "Interrompu"],
          "description": "Workflow execution status"
        },
        "datePlanifiee": {
          "type": "string",
          "description": "Scheduled start ISO timestamp"
        },
        "ligneProductionId": {
          "type": "number",
          "description": "Target production line ID"
        },
        "createdBy": {
          "type": "string",
          "description": "Author UID"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "articleCode", "quantiteDemandee", "statut", "createdBy"]
    },
    "MouvementStockDoc": {
      "title": "MouvementStockDoc",
      "description": "Stock movement audit entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Movement ID"
        },
        "date": {
          "type": "string",
          "description": "Movement timestamp"
        },
        "articleCode": {
          "type": "string",
          "description": "Article SKU"
        },
        "type": {
          "type": "string",
          "enum": ["ENTREE_RECEPTION", "SORTIE_PRODUCTION", "ENTREE_PRODUCTION", "AJUSTEMENT_INVENTAIRE"],
          "description": "Movement type"
        },
        "quantite": {
          "type": "number",
          "description": "Delta quantity"
        },
        "referenceDocument": {
          "type": "string",
          "description": "Associated document reference"
        },
        "createdBy": {
          "type": "string",
          "description": "Operator UID"
        }
      },
      "required": ["id", "date", "articleCode", "type", "quantite", "createdBy"]
    },
    "InterventionMaintenanceDoc": {
      "title": "InterventionMaintenanceDoc",
      "description": "Log entry of maintenance intervention on factory machines",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Intervention unique ID"
        },
        "date": {
          "type": "string",
          "description": "ISO timestamp of the intervention"
        },
        "machineId": {
          "type": "number",
          "description": "ID of the target machine"
        },
        "machineNom": {
          "type": "string",
          "description": "Name of the target machine"
        },
        "technicien": {
          "type": "string",
          "description": "Name of technician who performed the repair"
        },
        "descriptionPanne": {
          "type": "string",
          "description": "Detailed description of the repaired breakdown/fault"
        },
        "typeIntervention": {
          "type": "string",
          "enum": ["Curative", "Preventive", "Ameliorative", "Urgente"],
          "description": "Nature of intervention"
        },
        "dureeMinutes": {
          "type": "number",
          "description": "Duration in minutes"
        },
        "statutMachineApres": {
          "type": "string",
          "enum": ["Operationnelle", "EnObservation", "AttentePieces"],
          "description": "Status of machine after repair"
        },
        "piecesRemplacees": {
          "type": "string",
          "description": "Spare parts replaced"
        },
        "createdBy": {
          "type": "string",
          "description": "Author UID"
        }
      },
      "required": ["id", "date", "machineId", "machineNom", "technicien", "descriptionPanne", "createdBy"]
    },
    "ControleQualiteDoc": {
      "title": "ControleQualiteDoc",
      "description": "Quality control inspection record per manufacturing lot",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Inspection record ID"
        },
        "numeroLot": {
          "type": "string",
          "description": "Target batch number"
        },
        "numeroOF": {
          "type": "string",
          "description": "Related OF number"
        },
        "articleCode": {
          "type": "string",
          "description": "Article SKU"
        },
        "articleDesignation": {
          "type": "string",
          "description": "Article designation"
        },
        "inspecteur": {
          "type": "string",
          "description": "Inspector name"
        },
        "phaseControle": {
          "type": "string",
          "enum": ["CuveMelange", "EnCoursFabrication", "FinConditionnement", "LiberationLot"],
          "description": "Control phase"
        },
        "decision": {
          "type": "string",
          "enum": ["Conforme", "NonConforme", "EnQuarantaine", "Derogation"],
          "description": "Quality verdict"
        },
        "conforme": {
          "type": "boolean",
          "description": "Overall compliance flag"
        },
        "alertesCount": {
          "type": "number",
          "description": "Number of warning parameters"
        },
        "critiquesCount": {
          "type": "number",
          "description": "Number of critical out of tolerance parameters"
        },
        "dateControle": {
          "type": "string",
          "description": "Inspection timestamp"
        },
        "aspectVisuel": {
          "type": "string",
          "enum": ["Conforme", "ParticulesDetectees", "TurbiditeAnormale", "CouleurNonConforme"],
          "description": "Visual appearance"
        },
        "remarques": {
          "type": "string",
          "description": "Inspector notes"
        },
        "createdBy": {
          "type": "string",
          "description": "Author UID"
        }
      },
      "required": ["id", "numeroLot", "articleCode", "inspecteur", "decision", "dateControle", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC permissions"
    },
    "/ordres_fabrication/{ofId}": {
      "schema": "OrdreFabricationDoc",
      "description": "Active and historical manufacturing orders"
    },
    "/mouvements_stock/{mouvementId}": {
      "schema": "MouvementStockDoc",
      "description": "Immutable ledger of inventory transactions"
    },
    "/interventions_maintenance/{interventionId}": {
      "schema": "InterventionMaintenanceDoc",
      "description": "Audit log of machine maintenance and repairs"
    },
    "/controles_qualite/{qcId}": {
      "schema": "ControleQualiteDoc",
      "description": "Quality control inspection records and batch analytical releases"
    }
  }
}
